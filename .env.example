# Скопируйте этот файл в .env и выберите ОДИН вариант LLM.
#   cp .env.example .env
# Файл .env содержит настройки и НЕ должен попадать в git.

# ---------- Вариант 1: локальный Ollama (бесплатно, без интернета) ----------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen3:8b

# ---------- Вариант 2: OpenRouter (внешний API, нужен ключ) ----------
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-ВАШ_КЛЮЧ
# LLM_MODEL=qwen/qwen-2.5-7b-instruct

# ---------- Вариант 3: Yandex Cloud Foundation Models (нужен ключ) ----------
# LLM_BASE_URL=https://foundationmodels.api.cloud.yandex.net/v1
# LLM_API_KEY=ВАШ_КЛЮЧ
# LLM_MODEL=yandexgpt-lite

# ---------- Вариант 4: OpenAI (нужен ключ) ----------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-ВАШ_КЛЮЧ
# LLM_MODEL=gpt-4o-mini

# Температура генерации: 0.0 = строго и предсказуемо, 1.0 = максимально творчески.
# Для оценки качества диалогов ставьте низкое значение.
LLM_TEMPERATURE=0.2

# Таймаут ожидания ответа модели, секунд
LLM_TIMEOUT_SECONDS=60
